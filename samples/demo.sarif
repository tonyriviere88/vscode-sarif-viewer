{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DemoLinter",
          "semanticVersion": "1.4.2",
          "informationUri": "https://example.com/demolinter",
          "rules": [
            {
              "id": "DL0001",
              "name": "UnusedVariable",
              "shortDescription": { "text": "A declared variable is never read." },
              "helpUri": "https://example.com/demolinter/rules/DL0001",
              "defaultConfiguration": { "level": "warning" }
            },
            {
              "id": "DL0002",
              "name": "NullDereference",
              "shortDescription": { "text": "A value that may be null is dereferenced." },
              "helpUri": "https://example.com/demolinter/rules/DL0002",
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "DL0003",
              "name": "PreferConstAssertion",
              "shortDescription": { "text": "Use a const assertion for literal unions." },
              "messageStrings": {
                "default": { "text": "Prefer 'as const' over an explicit type annotation on {0}." }
              },
              "defaultConfiguration": { "level": "note" }
            },
            {
              "id": "DL0004",
              "name": "TaintedInput",
              "shortDescription": { "text": "Untrusted input reaches a sensitive sink." },
              "helpUri": "https://example.com/demolinter/rules/DL0004",
              "defaultConfiguration": { "level": "error" }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": { "uri": "file:///build/agent/work/1/s/" }
      },
      "results": [
        {
          "ruleId": "DL0002",
          "ruleIndex": 1,
          "level": "error",
          "message": { "text": "'document' may be undefined here." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/extension.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 20, "startColumn": 3, "endColumn": 30 }
              }
            }
          ],
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/extension.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 16, "startColumn": 9 }
              },
              "message": { "text": "the value is created here" }
            }
          ]
        },
        {
          "ruleId": "DL0001",
          "message": { "text": "Variable 'syncView' is assigned but its result is never used." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/extension.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 27 }
              }
            }
          ]
        },
        {
          "ruleId": "DL0001",
          "message": { "text": "Parameter 'element' shadows an outer binding." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/tree.ts", "uriBaseId": "%SRCROOT%" },
                "region": {
                  "startLine": 71,
                  "startColumn": 3,
                  "endLine": 79,
                  "endColumn": 4,
                  "snippet": { "text": "getChildren(element?: TreeNode): TreeNode[] {" }
                }
              }
            }
          ]
        },
        {
          "ruleId": "DL0003",
          "ruleIndex": 2,
          "message": {
            "id": "default",
            "arguments": ["LEVEL_ORDER"]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/model.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 7, "startColumn": 14, "endColumn": 25 }
              }
            }
          ]
        },
        {
          "ruleId": "DL0004",
          "ruleIndex": 3,
          "level": "error",
          "message": { "text": "Untrusted path from a SARIF log reaches the filesystem." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/pathResolver.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 60, "startColumn": 5, "endColumn": 40 }
              }
            }
          ],
          "codeFlows": [
            {
              "message": { "text": "Flow from the log file to a stat() call" },
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": { "uri": "src/model.ts", "uriBaseId": "%SRCROOT%" },
                          "region": { "startLine": 88, "startColumn": 11 }
                        },
                        "message": { "text": "the log is parsed from untrusted JSON" }
                      },
                      "nestingLevel": 0,
                      "executionOrder": 1
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": { "uri": "src/pathResolver.ts", "uriBaseId": "%SRCROOT%" },
                          "region": { "startLine": 30, "startColumn": 5 }
                        },
                        "message": { "text": "the raw uri flows into resolve()" }
                      },
                      "nestingLevel": 0,
                      "executionOrder": 2
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": { "uri": "src/pathResolver.ts", "uriBaseId": "%SRCROOT%" },
                          "region": { "startLine": 60, "startColumn": 5 }
                        },
                        "message": { "text": "and is passed to the filesystem" }
                      },
                      "nestingLevel": 1,
                      "executionOrder": 3
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "DL0001",
          "level": "note",
          "message": { "text": "This result is suppressed and hidden unless you enable suppressed results." },
          "suppressions": [{ "kind": "inSource", "justification": "reviewed and accepted" }],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/highlight.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 12, "startColumn": 3 }
              }
            }
          ]
        },
        {
          "ruleId": "DL0002",
          "level": "warning",
          "message": { "text": "This one points at a file that does not exist locally, to show the fallback." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/does-not-exist.ts", "uriBaseId": "%SRCROOT%" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
